# Copy to .env (never commit .env). In the hackathon lab this file is written for you.
# EVE_API_KEY is generated for each participant.
# The chat endpoint is {EVE_API_BASE_URL}/v1 and the MCP gateway is {EVE_API_BASE_URL}/mcp.
PARTICIPANT=local
WORKSHOP_NAME=local
EVE_API_BASE_URL=https://hackathon.eve-chat.chat/api
EVE_API_KEY=
EVE_LLM_MODEL=jsc/alias-eve
NOMINATIM_USER_AGENT=
